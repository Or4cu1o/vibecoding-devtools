// Kit Markdown rules, read by CI and the local command (markdownlint-cli2 0.24.0, the action's version).
{
  "config": {
    "default": true,
    // 120 columns in prose; tables, code blocks and headings are exempt.
    "MD013": { "line_length": 120, "tables": false, "code_blocks": false, "headings": false, "stern": true },
    // Code blocks always fenced (```), with a language.
    "MD046": { "style": "fenced" },
    // CHANGELOG repeats "Added" and "Changed" for each version.
    "MD024": { "siblings_only": true },
    // Templates use <placeholders> for users to fill in.
    "MD033": false,
    // Project CLAUDE.md starts with @AGENTS.md, not a heading.
    "MD041": false,
    // Compact tables (|---|), as in the rest of the kit.
    "MD060": false
  },
  "ignores": ["node_modules/**", ".maestri/**"]
}
